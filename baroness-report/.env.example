# 기존 PostgreSQL DB 접속 정보 (baroness) — 실제 값은 .env.local에 넣고 절대 커밋하지 않는다.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# 원격 DB가 SSL을 요구하면 true
DB_SSL=false

# 로컬 개발 전용: 플랫폼 게이트웨이가 없어 /api/platform/user-info를 호출할 수 없을 때
# 이 값으로 로그인 사용자를 대신한다 (violet.tb_users_sso_accounts.provider_user_id와 매칭).
NEXT_PUBLIC_DEV_PROVIDER_USER_ID=
